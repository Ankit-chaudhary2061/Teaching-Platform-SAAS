{
  "compilerOptions": {
    // File Layout
    "rootDir": ".", // Include server.ts (outside src)
    "outDir": "./dist",
    // Environment Settings
    "module": "nodenext",
    "moduleResolution": "nodenext", // Add for Node.js ESM resolution
    "target": "esnext",
    "types": ["node"], // Include Node.js types
    "lib": ["esnext"], // Include ESNext libraries
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
   "allowImportingTsExtensions": true, // Allow .ts extensions
    "noEmit": true // Add this
  },
  "include": ["src/**/*", "server.ts"], // Include server.ts explicitly
  "exclude": ["node_modules", "dist"]
}